# Environment

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todo_axios_db
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

SESSION_COOKIE_SECURE=false

# JWT signing secret — replace with a long random string in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32
